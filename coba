<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="no-referrer">
  <title>Tes Tampilan</title>
  <style>
    body {
      background-color: #f0f7ff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      padding: 20px;
      font-family: sans-serif;
      text-align: center;
    }

    .sticker {
      width: 160px;
      height: 160px;
      object-fit: contain;
      margin-bottom: 20px;
    }

    .photo-card {
      width: 100%;
      max-width: 320px;
      border-radius: 20px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.12);
      display: block;
    }

    h2 {
      color: #1e3a8a;
      margin-top: 15px;
      font-size: 1.1rem;
    }
  </style>
</head>
<body>

  <!-- Stiker Stitch Transparan -->
  <img src="stiker.png" class="sticker" alt="Stiker Stitch">

  <!-- Foto 1 -->
  <img src="foto1.jpg" class="photo-card" alt="Foto 1">

  <h2>Kalau stikernya udah transparan & fotonya muncul, berarti aman!</h2>

</body>
</html>
